# Nobrayn : tout le trafic vers https://nobrayn.fr
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://nobrayn.fr%{REQUEST_URI} [L,R=301]

# Les pages HTML sont toujours revérifiées : les mises à jour arrivent tout de suite sur les téléphones
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
